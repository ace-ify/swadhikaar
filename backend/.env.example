# Copy to backend/.env and fill in. Leave a value BLANK rather than pasting a
# placeholder string — agent.py treats anything starting with "your-" as unset, and a
# blank is honest. A placeholder that looks configured is what caused every voice call
# in this project to silently save nothing for weeks: SUPABASE_KEY held the literal
# text "your-service-role-key", so the client 401'd and dropped every transcript,
# escalation and journey update while the dashboards stayed green.
#
# Sanity-check the LLM config after editing this file:
#   .venv/Scripts/python backend/voice_agent/preflight_llm.py

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=
# The service key. New-style sb_secret_... preferred; agent.py checks
# SUPABASE_SECRET_KEY, then SUPABASE_SERVICE_ROLE_KEY, then SUPABASE_KEY.
SUPABASE_SECRET_KEY=

# --- LiveKit ------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM Chain: Gemini (Primary) -> Groq (Fallback) -> LiveKit Inference (Tertiary) ---
# Primary: Google Gemini (Free tier gives 1,000,000 TPM with tool calling & Hindi)
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.5-flash

# Secondary Fallback: Groq (ultra-fast inference ~500ms when Gemini is busy)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tertiary Fallback: LiveKit Cloud Inference (runs on LiveKit servers with monthly free credits)
# Uses your existing LIVEKIT_API_KEY / LIVEKIT_API_SECRET without extra keys.
# Recommended: google/gemini-2.5-flash (cheapest, highest limit, tool calling OK)
LIVEKIT_INFERENCE_MODEL=google/gemini-2.5-flash

# Timeout (seconds) before FallbackAdapter switches to the next LLM.
# Must be >= 10.0s because Google Gemini rejects deadlines under 10s. Default is 15.0.
LLM_ATTEMPT_TIMEOUT=15.0

# Optional extra fallback leg (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- TTS ----------------------------------------------------------------------
# Providers: murf | rime | sarvam | google. FAST_TTS_PROVIDER is tried first, then
# the others in that order. A provider with no voice for the call's language is
# skipped automatically (see MURF_VOICES / RIME_VOICES / SARVAM_LANGS in agent.py)
# rather than used with the wrong voice.
FAST_TTS_PROVIDER=murf
MURF_API_KEY=
# MURF_MODEL selects which VOICE CATALOGUE exists. FALCON is the streaming library
# (117 voices) and is what the LiveKit plugin defaults to; the unfiltered
# /v1/speech/voices endpoint returns a different 162-voice Gen2 studio library, and
# the two barely overlap. Voice ids from one 400 on the other. Do not change this
# without re-verifying every id in MURF_VOICES.
MURF_MODEL=FALCON
# There is deliberately no MURF_VOICE / MURF_LOCALE / MURF_STYLE here. Voice, locale
# and style are one fact about the caller's language, not three independent knobs,
# so they live together in MURF_VOICES. A global style is wrong on its face: anisha
# advertises "Conversation" while most FALCON voices advertise "Conversational".
# Override MURF_SPEED / MURF_PITCH if you need to tune delivery.

# Rime. Two of our languages only — Hindi and English — so FAST_TTS_PROVIDER=rime
# still hands Assamese, Bengali, Tamil, Gujarati and Urdu calls to Murf. That
# fallback is the intended behaviour and it is visible in the log line
# "FAST PIPELINE TTS: <provider> speaking <locale>".
RIME_API_KEY=
# coda is the only Rime model with Hindi. mistv3 has eng/spa/ger/fra, and the bracket
# phonemization knobs are wired to mist models only — so for Hindi they do not exist.
RIME_MODEL=coda
# There is deliberately no RIME_VOICE / RIME_LANG here, for the same reason there is
# no MURF_VOICE: speaker and language are one fact about the caller, and they live
# together in RIME_VOICES. Leaving speaker unset is actively dangerous — it resolves
# to "astra" or "lyra" depending on whether the model was named, and both are English.
# Optional. speed_alpha is the only speed control that survives the WebSocket path.
RIME_SPEED_ALPHA=

# Alternatives, in fallback order after murf.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_VOICE=anushka
# No SARVAM_LANGUAGE: the language comes from the caller, and pinning it here
# would speak Hindi to a Bengali patient.
# Google Cloud TTS needs a SERVICE ACCOUNT — it rejects API keys, so the
# GOOGLE_API_KEY above (Gemini) will not work for TTS. Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=

# STT only. aura-*-en voices are ENGLISH, so Deepgram is not in the TTS chain.
DEEPGRAM_API_KEY=

# --- SIP / telephony (outbound calls via LiveKit) ------------------------------
# Only the edge function dials, so SIP_TRUNK_ID is set as a Supabase secret
# (`supabase secrets set`), not read by the Python worker. Kept here for reference.
SIP_TRUNK_URI=
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_CALLER_ID=
SIP_TRUNK_ID=

# --- App ----------------------------------------------------------------------
ENVIRONMENT=development
VOICE_PIPELINE=fast
