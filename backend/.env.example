# Copy to backend/.env and fill in. Leave a value BLANK rather than pasting a
# placeholder string — agent.py treats anything starting with "your-" as unset, and a
# blank is honest. A placeholder that looks configured is what caused every voice call
# in this project to silently save nothing for weeks: SUPABASE_KEY held the literal
# text "your-service-role-key", so the client 401'd and dropped every transcript,
# escalation and journey update while the dashboards stayed green.
#
# Sanity-check the LLM config after editing this file:
#   .venv/Scripts/python backend/voice_agent/preflight_llm.py

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=
# The service key. New-style sb_secret_... preferred; agent.py checks
# SUPABASE_SECRET_KEY, then SUPABASE_SERVICE_ROLE_KEY, then SUPABASE_KEY.
SUPABASE_SECRET_KEY=

# --- LiveKit ------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM ----------------------------------------------------------------------
# The model MUST support tool calling: the agent registers five function tools
# (escalate_patient, update_risk_level, update_journey_status, record_vitals,
# confirm_vaccination_visit). A model without it returns 400 on EVERY turn, which
# means no TTS and a caller hearing silence. Verified on Groq 2026-08-23:
#   openai/gpt-oss-120b   tool calling OK, speaks Hindi   <- default
#   groq/compound-mini    400: no tool calling
#   groq/compound         400: no tool calling
#   llama-3.3-70b-*       404: retired by Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback leg of llm.FallbackAdapter. Worth setting: if the primary rate-limits
# mid-call and this is empty, the call goes silent. Free key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-3-flash-preview

# --- TTS ----------------------------------------------------------------------
# Ordered preference, degrading to the next only if a provider is unavailable at
# startup (see the tts_chain in agent.py). Not a runtime failover chain.
FAST_TTS_PROVIDER=murf
MURF_API_KEY=
MURF_VOICE=en-IN-anisha
MURF_MODEL=FALCON
MURF_STYLE=Conversation

# Optional alternatives. Note aura-*-en voices are ENGLISH — Deepgram TTS is a
# last-resort fallback only, not an Indic voice.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_VOICE=anushka
SARVAM_LANGUAGE=hi-IN
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-2
CARTESIA_LANGUAGE=hi

# --- SIP / telephony (outbound calls via LiveKit) ------------------------------
# Only the edge function dials, so SIP_TRUNK_ID is set as a Supabase secret
# (`supabase secrets set`), not read by the Python worker. Kept here for reference.
SIP_TRUNK_URI=
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_CALLER_ID=
SIP_TRUNK_ID=

# --- App ----------------------------------------------------------------------
ENVIRONMENT=development
VOICE_PIPELINE=fast
