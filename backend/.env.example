# Copy to backend/.env and fill in. Leave a value BLANK rather than pasting a
# placeholder string — agent.py treats anything starting with "your-" as unset, and a
# blank is honest. A placeholder that looks configured is what caused every voice call
# in this project to silently save nothing for weeks: SUPABASE_KEY held the literal
# text "your-service-role-key", so the client 401'd and dropped every transcript,
# escalation and journey update while the dashboards stayed green.
#
# Sanity-check the LLM config after editing this file:
#   .venv/Scripts/python backend/voice_agent/preflight_llm.py

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=
# The service key. New-style sb_secret_... preferred; agent.py checks
# SUPABASE_SECRET_KEY, then SUPABASE_SERVICE_ROLE_KEY, then SUPABASE_KEY.
SUPABASE_SECRET_KEY=

# --- LiveKit ------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM ----------------------------------------------------------------------
# The model MUST support tool calling: the agent registers five function tools
# (escalate_patient, update_risk_level, update_journey_status, record_vitals,
# confirm_vaccination_visit). A model without it returns 400 on EVERY turn, which
# means no TTS and a caller hearing silence. Verified on Groq 2026-08-23:
#   openai/gpt-oss-120b   tool calling OK, speaks Hindi   <- default
#   groq/compound-mini    400: no tool calling
#   groq/compound         400: no tool calling
#   llama-3.3-70b-*       404: retired by Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback leg of llm.FallbackAdapter. Worth setting: if the primary rate-limits
# mid-call and this is empty, the call goes silent. Free key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-3-flash-preview

# --- TTS ----------------------------------------------------------------------
# Providers: murf | sarvam | google. FAST_TTS_PROVIDER is tried first, then the
# others in that order. A provider with no voice for the call's language is
# skipped automatically (see MURF_VOICES / SARVAM_LANGS in agent.py), so an
# Assamese call routed to bn-IN never lands on an English voice.
FAST_TTS_PROVIDER=murf
MURF_API_KEY=
# Leave MURF_VOICE UNSET. Unset means "pick the voice for the caller's language"
# from MURF_VOICES; setting it pins ONE voice for every language, which is how
# every Hindi call ended up pointing at a voice that does not exist. Murf has
# native voices for hi-IN, en-IN, bn-IN and ta-IN, and reaches te/mr/gu/kn/ml/pa
# through a multi-native voice — all ten verified as real audio.
MURF_VOICE=
# Leave MURF_LOCALE unset too: it comes from MURF_VOICES per language. Passing a
# locale the chosen voice does not carry is a hard 400, not a soft fallback.
MURF_LOCALE=
MURF_MODEL=FALCON
# Either "Conversational" or "Conversation" is accepted (both verified 200 on
# 2026-08-25); "Conversational" is the value Murf's own availableStyles reports.
MURF_STYLE=Conversational

# Alternatives, in fallback order after murf.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_VOICE=anushka
# No SARVAM_LANGUAGE: the language comes from the caller, and pinning it here
# would speak Hindi to a Bengali patient.
# Google Cloud TTS needs a SERVICE ACCOUNT — it rejects API keys, so the
# GOOGLE_API_KEY above (Gemini) will not work for TTS. Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=

# STT only. aura-*-en voices are ENGLISH, so Deepgram is not in the TTS chain.
DEEPGRAM_API_KEY=

# --- SIP / telephony (outbound calls via LiveKit) ------------------------------
# Only the edge function dials, so SIP_TRUNK_ID is set as a Supabase secret
# (`supabase secrets set`), not read by the Python worker. Kept here for reference.
SIP_TRUNK_URI=
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_CALLER_ID=
SIP_TRUNK_ID=

# --- App ----------------------------------------------------------------------
ENVIRONMENT=development
VOICE_PIPELINE=fast
