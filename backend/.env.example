# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# LLM
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_LLM_MODEL=gemini-3-flash-preview
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
VOICE_PIPELINE=fast
FAST_TTS_PROVIDER=deepgram
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_VOICE=anushka
SARVAM_LANGUAGE=hi-IN
SARVAM_PACE=0.88
SARVAM_PITCH=-0.08
SARVAM_TTS_TEMPERATURE=0.42
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-2
CARTESIA_TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_LANGUAGE=hi
CARTESIA_SPEED=0.92

# App
ENVIRONMENT=development

# SIP / Twilio (for outbound phone calls via LiveKit)
SIP_TRUNK_URI=sip:xxxxx.pstn.twilio.com
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_CALLER_ID=+91XXXXXXXXXX
SIP_TRUNK_ID=
