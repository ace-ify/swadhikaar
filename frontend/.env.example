# Copy to .env.local. Both values are public by design — they are shipped to the
# browser — but the key must be the CURRENT publishable key for the project.
#
# Use the sb_publishable_... key, NOT the legacy JWT anon key (eyJhbGciOi...).
# Legacy keys are disabled on this project: a stale one there does not degrade
# anything gracefully, it returns 401 on sign-in and the app can only say
# "This page is out of date". Every screen looks broken and nothing says why.
#
# Dashboard → Project Settings → API keys → Publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-side only. Shared secret for POST /api/seam-trigger; must never carry a
# NEXT_PUBLIC_ prefix, or it ships to the browser and stops being a secret.
ACUTE_INGRESS_SECRET=<random-string>
